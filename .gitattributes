# Enforce LF line endings for shell scripts (Linux containers require LF)
*.sh text eol=lf

# Enforce LF for SQL files (executed inside Linux containers)
*.sql text eol=lf

# Enforce LF for config files used by Linux containers
*.conf text eol=lf
*.cfg text eol=lf

# Enforce LF and UTF-8 for source files (Windows editors may save with BOM)
*.tsx text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.js text eol=lf
