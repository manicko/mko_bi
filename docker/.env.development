# Environment Variables for mkobi BI Dashboard System (Development Template)
# Copy this file to .env.development and fill in your values for local development.
# Usage: docker compose --env-file .env.development -f docker-compose.yml -f docker-compose.override.yml up -d
# Note: These are placeholder values. Change them for your local environment.

# Environment
ENV=development

# Database settings (placeholder - use your local postgres password)
DATABASE__PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET
DATABASE__ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT settings (development only - use strong secret in production!)
# Generate with: openssl rand -hex 32
JWT__SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Admin credentials (use strong credentials in production)
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME
ADMIN_PASSWORD=CHANGE_ME_GENERATE_STRONG_PASSWORD

# Application role password
MKOBI_APP_PASSWORD=CHANGE_ME_GENERATE_STRONG_SECRET