# ============================================
# Environment Variables Configuration
# ============================================
# Copy this file to .env and fill in the required values
# Required variables are marked with (required)

# ============================================
# Database Configuration (required)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bidb
DB_USER=postgres
DB_PASSWORD=1234  # (required) Change this in production!
DB_DRIVER=postgresql

# Alternatively, you can use DATABASE_URL instead of separate DB_* variables:
# DATABASE_URL=postgresql://user:password@localhost:5432/bidb

# ============================================
# JWT Configuration (required)
# ============================================
JWT_SECRET_KEY=your-secret-key-change-in-production  # (required) Use a strong secret!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# Upload Configuration
# ============================================
UPLOAD_TEMP_DIR=data/tmp_uploads
ALLOWED_FILE_TYPES=.csv.gz
MAX_FILE_SIZE=104857600  # 100MB in bytes

# ============================================
# Logging Configuration
# ============================================
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_LEVEL=INFO

# ============================================
# App Configuration
# ============================================
APP_NAME=mko_bi
DEBUG=false  # Set to true for development

# ============================================
# Testing
# ============================================
# For running tests with SQLite in-memory database:
# DB_DRIVER=sqlite
