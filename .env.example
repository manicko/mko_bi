# Environment Variables for mkobi BI Dashboard System
# Copy this file to .env and update the values for your environment

# Environment: development, staging, production, test
ENV=development

# Database settings (use __ for nested)
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=your_password_here
DATABASE__DBNAME=bidb

# JWT settings
JWT__SECRET_KEY=your_jwt_secret_key_here
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30

# Upload settings
UPLOAD__TEMP_DIR=data/tmp_uploads
UPLOAD__MAX_FILE_SIZE_MB=100
UPLOAD__ALLOWED_EXTENSIONS='["csv.gz", "csv"]'
UPLOAD__ALLOWED_MIME_TYPES='["text/csv", "application/gzip"]'

# Redis settings (optional, for task queue)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
# REDIS__PASSWORD=your_redis_password

# App settings
APP_NAME=mkobi
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Logging
LOGGING__LEVEL=INFO
# LOGGING__LOG_FILE=/path/to/app.log
LOGGING__JSON_LOGGING=true

# CORS - origins allowed to access the API (JSON array format)
# For development: ["http://localhost:3000"]
# For production: specify exact domains, e.g. ["https://yourdomain.com"]
CORS_ORIGINS='["http://localhost:3000"]'

# Database migrations
AUTO_MIGRATE=true
MIGRATION_SCRIPT_PATH=alembic
ALEMBIC_INI_PATH=alembic.ini

# Docker secrets example (uncomment to use):
# DATABASE__PASSWORD_FILE=/run/secrets/db_password
# JWT__SECRET_KEY_FILE=/run/secrets/jwt_secret

# Production checklist:
# 1. Change JWT__SECRET_KEY to a strong secret
# 2. Change DATABASE__PASSWORD to a strong password
# 3. Set CORS_ORIGINS to specific domains (not "*")
# 4. Set DEBUG=false for production
# 5. Configure proper LOGGING__LOG_FILE for production
# 6. Enable HTTPS (via nginx or load balancer)
# 7. Enable rate limiting
# 8. Use Docker secrets for sensitive data
# 9. Run migrations: alembic upgrade head
# 10. Run tests: uv run pytest
